    {
      "id": "TAKyyDW00s6xCq0xMsPdT",
      "type": "text",
      "x": 505.5436766847757,
      "y": 276.50759237658144,
      "width": 400.77978515625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
