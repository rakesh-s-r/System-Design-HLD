      "seed": 844923044,
      "version": 134,
      "versionNonce": 1671418908,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785302630285,
      "link": null,
      "locked": false,
      "text": "Function Requirements\nLong URL map to short URL\n    - optionaly support custom alias name\n    - optionaly support expiration\nURL Redirection\nLink analytics(track)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Function Requirements\nLong URL map to short URL\n    - optionaly support custom alias name\n    - optionaly support expiration\nURL Redirection\nLink analytics(track)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4hzISNWGlRqNGcjCpR0OH",
      "type": "text",
      "x": 1219.5928925434264,
      "y": 282.1125279879778,
      "width": 540.0797119140625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b06",
      "roundness": null,
      "seed": 1962713124,
      "version": 132,
      "versionNonce": 1843485852,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785302735137,
      "link": null,
      "locked": false,
      "text": "Non-Function Requirements\nMinimize the redirect latency\n1billion user & Scale to support 100M daily active users\nEnsure uniqueness\nSupport CAP theroem",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Function Requirements\nMinimize the redirect latency\n1billion user & Scale to support 100M daily active users\nEnsure uniqueness\nSupport CAP theroem",
      "autoResize": true,
      "lineHeight": 1.25
    },
