      "versionNonce": 2122180550,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785266130313,
      "link": null,
      "locked": false,
      "text": "Suppose for distributed system (multiple servers talk each other shares request and response body), like for Alice 99 serves for server1\nand 2 server serves at server 2 at same time, we can share one Redis cache across distributed server, so we can keep track and reject other\nrequest with 429 status code",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Suppose for distributed system (multiple servers talk each other shares request and response body), like for Alice 99 serves for server1\nand 2 server serves at server 2 at same time, we can share one Redis cache across distributed server, so we can keep track and reject other\nrequest with 429 status code",
      "autoResize": true,
      "lineHeight": 1.25
    },
