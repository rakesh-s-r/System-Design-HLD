  "elements": [
    {
      "id": "zaRuaVmOU7kzrAqu6RUHW",
      "type": "text",
      "x": 505.800048828125,
      "y": 148.3000030517578,
      "width": 191.6598358154297,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "seed": 657289498,
      "version": 69,
      "versionNonce": 1731028762,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785254285488,
      "link": null,
      "locked": false,
      "text": "Design Rate Limiter",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Design Rate Limiter",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "19QTNr7uSEyn5OFLDc6ts",
      "type": "text",
      "x": 509.5999755859375,
      "y": 207.5,
      "width": 1490.5389404296875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 511960666,
      "version": 39,
      "versionNonce": 150842566,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785264049800,
      "link": null,
      "locked": false,
      "text": "A Rate Limiter is a mechanism that controls how many requests a client can make to a server within a specific time period. It is used to prevent abuse, \nprotect servers from overload, ensure fair resource usage, and improve system stability.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Rate Limiter is a mechanism that controls how many requests a client can make to a server within a specific time period. It is used to prevent abuse, \nprotect servers from overload, ensure fair resource usage, and improve system stability.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bsy_AC8ylHOZw-fDfaKxF",
      "type": "text",
      "x": 514.1448898345419,
      "y": 275.3036318466728,
      "width": 979.720458984375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 1038717786,
      "version": 3,
      "versionNonce": 40524186,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785264086264,
      "link": null,
      "locked": false,
      "text": "Example\n\nSuppose an API allows 100 requests per minute for each user.\n\n✅ First 100 requests → Allowed\n❌ 101st request within the same minute → Rejected (usually with HTTP 429: Too Many Requests)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example\n\nSuppose an API allows 100 requests per minute for each user.\n\n✅ First 100 requests → Allowed\n❌ 101st request within the same minute → Rejected (usually with HTTP 429: Too Many Requests)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0alWLvgrsggoDAQ4N2Rjx",
      "type": "text",
      "x": 518.4525989137007,
      "y": 443.57450114570895,
      "width": 1475.6390380859375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 2058806682,
      "version": 130,
      "versionNonce": 1163823322,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785264372512,
      "link": null,
      "locked": false,
      "text": "Types of Rate limiter Algorithm\n1. Sliding window:  Stores the timestamp of every request. Removes timestamps older than the configured window.\n2. Fixed Window: Limit: 100 requests/minute, 100 requests at 12:00:59 and another 100 at 12:01:00 are all allowed.\n3. Sliding Window Counter: Combines the current and previous windows using a weighted calculation.\n4. Token Bucket: Tokens are added to a bucket at a fixed rate., Each request consumes one token., Requests are allowed only if tokens are available.\n5. Leaky Bucket: Requests enter a queue (bucket)., They are processed at a constant rate.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Types of Rate limiter Algorithm\n1. Sliding window:  Stores the timestamp of every request. Removes timestamps older than the configured window.\n2. Fixed Window: Limit: 100 requests/minute, 100 requests at 12:00:59 and another 100 at 12:01:00 are all allowed.\n3. Sliding Window Counter: Combines the current and previous windows using a weighted calculation.\n4. Token Bucket: Tokens are added to a bucket at a fixed rate., Each request consumes one token., Requests are allowed only if tokens are available.\n5. Leaky Bucket: Requests enter a queue (bucket)., They are processed at a constant rate.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uuZzS2DZRxyKq38B4ij1z",
      "type": "text",
      "x": 531.9142668143537,
      "y": 643.884103074724,
      "width": 463.5196533203125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 1064224774,
      "version": 4,
      "versionNonce": 1679769030,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785264406083,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n- identify users by id, ip, or api key\n- limit requests based on configurable rules\n- return proper error headers and status codes\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n- identify users by id, ip, or api key\n- limit requests based on configurable rules\n- return proper error headers and status codes\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6CZs1pSd3oDRJk_emmQhe",
      "type": "text",
      "x": 1257.4981666595445,
      "y": 639.8456027045281,
      "width": 274.45977783203125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 834046854,
      "version": 3,
      "versionNonce": 868344326,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785264408981,
      "link": null,
      "locked": false,
      "text": "Non-functional Requirements\n- low latency check (< 10ms)\n- availability >> consistency\n- scale to 1M rps",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional Requirements\n- low latency check (< 10ms)\n- availability >> consistency\n- scale to 1M rps",
      "autoResize": true,
      "lineHeight": 1.25
    },
