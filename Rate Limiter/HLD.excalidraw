      "type": "text",
      "x": 557.4914358255941,
      "y": 1573.0961900261732,
      "width": 1389.6390380859375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
