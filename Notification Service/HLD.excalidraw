      "isDeleted": false,
      "boundElements": [],
      "updated": 1785434559943,
      "link": null,
      "locked": false,
      "text": "Function Requirements\n- Push notification sent to android, iPhone\nlaptop, real time notification\n- Every time u open app, u will see notification like\ndo u want to recieve notification, if u say yes, it will store \nur token in DB",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Function Requirements\n- Push notification sent to android, iPhone\nlaptop, real time notification\n- Every time u open app, u will see notification like\ndo u want to recieve notification, if u say yes, it will store \nur token in DB",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4hzISNWGlRqNGcjCpR0OH",
      "type": "text",
      "x": 1207.5129794676184,
      "y": 192.06161373744612,
      "width": 290.27978515625,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
