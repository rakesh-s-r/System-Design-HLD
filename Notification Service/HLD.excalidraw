      "isDeleted": false,
      "boundElements": [],
      "updated": 1785435125073,
      "link": null,
      "locked": false,
      "text": "Non-Function Requirements\nHigh throughput (millions/day)\nLow latency\nReliable delivery\nRetry on failure\nUser notification preferences\nScheduling\nDeduplication\nRate limiting\nMonitoring",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Function Requirements\nHigh throughput (millions/day)\nLow latency\nReliable delivery\nRetry on failure\nUser notification preferences\nScheduling\nDeduplication\nRate limiting\nMonitoring",
      "autoResize": true,
