      "link": null,
      "locked": false,
      "text": "- Payment process is different and UPI payment is different\n- UPI is not a payment processor nor a payment gateway it works like infrastructure",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Payment process is different and UPI payment is different\n- UPI is not a payment processor nor a payment gateway it works like infrastructure",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kuNOky_zwFG-26RVmLm-l",
      "type": "text",
      "x": 541.8268437149134,
      "y": -24.14134004943071,
      "width": 219.35983276367188,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
