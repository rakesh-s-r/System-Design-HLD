      "index": "a6",
      "roundness": null,
      "seed": 297393885,
      "version": 132,
      "versionNonce": 1779840157,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785600165263,
      "link": null,
      "locked": false,
      "text": "Functional Requirement\nLink bank accounts\nSend money to another user\nReceive money\nCheck transaction status\nView transaction history",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirement\nLink bank accounts\nSend money to another user\nReceive money\nCheck transaction status\nView transaction history",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6IE1lIL6McJTGe1NG3j04",
      "type": "text",
      "x": 916.6181548960122,
      "y": -32.740047549786254,
      "width": 332.19171142578125,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 1909628659,
      "version": 210,
      "versionNonce": 1988045459,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785600180208,
      "link": null,
      "locked": false,
      "text": "Non Functional Requirement\n99.99% availability\nNo double payment\nStrong consistency for money movement\nHigh throughput (millions TPS during peak)\nFault tolerant\nIdempotent\nSecure",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non Functional Requirement\n99.99% availability\nNo double payment\nStrong consistency for money movement\nHigh throughput (millions TPS during peak)\nFault tolerant\nIdempotent\nSecure",
      "autoResize": true,
      "lineHeight": 1.25
